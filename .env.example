# ===== WSP Anonymizer =====
NODE_ENV=production
HOST=127.0.0.1
PORT=3000
DATA_DIR=/var/lib/wsp-anonymizer
MAX_UPLOAD_MB=50

# Секреты (install.sh сгенерирует сам). MASTER_KEY — сохранить в Teampass!
MASTER_KEY=
SESSION_SECRET=
SESSION_HOURS=8

# Сроки хранения: готовые файлы (часы), таблицы замен (дни, 0 = бессрочно)
RESULT_TTL_HOURS=72
MAPPING_TTL_DAYS=365

# --- Клиентский сертификат (проверяет nginx) ---
REQUIRE_CLIENT_CERT=true
# off | cn | email — сертификат должен принадлежать вошедшему пользователю
CERT_USER_MATCH=cn

# --- Active Directory ---
AUTH_MODE=ldap
LDAP_URL=ldaps://dc01.wsp.local:636
LDAP_BIND_DN=CN=svc-anonymizer,OU=Service Accounts,DC=wsp,DC=local
LDAP_BIND_PASSWORD=
LDAP_BASE_DN=DC=wsp,DC=local
LDAP_USER_ATTR=sAMAccountName
# Кому разрешён вход (вложенные группы учитываются). Пусто = всем пользователям домена
LDAP_ALLOWED_GROUP_DN=CN=GG-Anonymizer-Users,OU=Groups,DC=wsp,DC=local
# Админы видят все задания и журнал
LDAP_ADMIN_GROUP_DN=CN=GG-Anonymizer-Admins,OU=Groups,DC=wsp,DC=local
# Корневой сертификат AD CS для ldaps (PEM)
LDAP_CA_FILE=/etc/wsp-anonymizer/tls/ad-root-ca.pem
LDAP_TLS_REJECT_UNAUTHORIZED=true

# --- LLM (Ollama) ---
LLM_ENABLED=true
OLLAMA_URL=http://10.0.0.50:11434
OLLAMA_MODEL=qwen3:14b
OLLAMA_NUM_CTX=8192
OLLAMA_KEEP_ALIVE=30m
LLM_CHUNK_CHARS=3000
LLM_TIMEOUT_MS=300000
QUEUE_CONCURRENCY=1

# --- Словарь известных сущностей (проверка ДО отправки в LLM) ---
KNOWN_DICT_ENABLED=true
KNOWN_DICT_TYPES=PER,ORG,ADDR,DOC,ID
KNOWN_DICT_MIN_LEN=4
# Скрывать уже найденное в тексте, который уходит в модель (модель ищет только новое)
KNOWN_MASK_FOR_LLM=true

# --- OCR ---
OCR_LANGS=rus+eng
OCR_DPI=300
OCR_MIN_CHARS_PER_PAGE=80
